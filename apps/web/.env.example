# Postgres (Neon em produção; ver packages/db/README.md para desenvolvimento local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/lotopro"

# Better Auth — gerar com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Google (AU-03)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Asaas — webhook (SY-13). Mesmo token configurado no painel do Asaas; usado tanto por
# app/api/webhooks/asaas/route.ts quanto por admin.finance.replayWebhook (BO-36).
ASAAS_WEBHOOK_TOKEN=""

# Redis — BullMQ (mesma instância do worker, ver apps/worker/.env). Usado por
# admin.config.resync (BO-41) para enfileirar re-sync de uma modalidade na fila
# `sync-results` que o worker consome.
REDIS_URL="redis://localhost:6379"
