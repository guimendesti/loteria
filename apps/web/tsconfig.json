{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `**/__tests__/**`/`**/*.test.ts`: testes escritos "prontos" mas ainda não
  // cabeados (apps/web não tem `vitest` como devDependency nem script `test` —
  // ver apps/web/package.json e o relatório do router `bets`). Excluídos do
  // typecheck do app até essa dependência ser adicionada numa próxima onda;
  // remover esta exclusão junto com a instalação do vitest.
  "exclude": ["node_modules", "**/*.test.tsx"]
}
